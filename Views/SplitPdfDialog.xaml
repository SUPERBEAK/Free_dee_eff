<Window x:Class="Freedeeeff.Views.SplitPdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Split PDF Document"
        Icon="pack://application:,,,/Assets/app.png"
        Height="520" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Split PDF into Separate Files" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="TxtDocumentInfo" Text="Source: document.pdf (10 pages)" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Split Mode Options -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Splitting Method" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                <RadioButton x:Name="RbAllPages" Content="Split every page into an individual single-page PDF" IsChecked="True" Checked="Mode_Changed" Margin="0,0,0,8"/>
                
                <RadioButton x:Name="RbRanges" Content="Split by page ranges (e.g. 1-3, 4-7, 8-10)" Checked="Mode_Changed" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtRanges" Text="1-2, 3-4" Margin="24,0,0,12" Height="34" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="TxtRanges_TextChanged"/>

                <RadioButton x:Name="RbEveryN" Content="Split every N pages into equal parts" Checked="Mode_Changed" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,12">
                    <TextBlock Text="Pages per split:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtEveryN" Text="2" Width="60" Height="32" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="TxtEveryN_TextChanged"/>
                </StackPanel>

                <RadioButton x:Name="RbSelectedPages" Content="Extract only currently selected pages from sidebar" Checked="Mode_Changed" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <!-- Output Settings & Preview -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Output Location &amp; Naming" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="Destination Folder:" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputDir" Height="34" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="14,0" Height="34" Click="BtnBrowse_Click"/>
                </Grid>

                <TextBlock Text="File Name Prefix:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFilePrefix" Text="Document" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10" TextChanged="TxtFilePrefix_TextChanged"/>

                <TextBlock x:Name="TxtPreview" Text="Preview: Document_page_001.pdf, Document_page_002.pdf..." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Status / Progress -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <ProgressBar x:Name="ProgressSplit" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtStatus" Text="" FontSize="12" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnOpenFolder" Grid.Column="0" Content="Open Output Folder" Visibility="Collapsed" Padding="12,8" Click="BtnOpenFolder_Click"/>

            <Button Grid.Column="2" Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSplit" Grid.Column="3" Content="Split PDF" Style="{DynamicResource AccentButtonStyle}" Padding="20,8" Click="BtnSplit_Click"/>
        </Grid>
    </Grid>
</Window>
