<Window x:Class="Freedeeeff.Views.MergePdfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge PDF Documents"
        Icon="pack://application:,,,/Assets/app.png"
        Height="480" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Merge Multiple PDFs into a Single File" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Add and arrange PDF files in the desired order." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Files List & Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="LstFiles" SelectionMode="Single" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="4">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="120">
                <Button Content="Add Files..." Padding="10,6" Margin="0,0,0,8" Click="BtnAddFiles_Click"/>
                <Button Content="Move Up" Padding="10,6" Margin="0,0,0,8" Click="BtnMoveUp_Click"/>
                <Button Content="Move Down" Padding="10,6" Margin="0,0,0,8" Click="BtnMoveDown_Click"/>
                <Button Content="Remove" Padding="10,6" Margin="0,0,0,8" Click="BtnRemove_Click"/>
                <Button Content="Clear All" Padding="10,6" Click="BtnClear_Click"/>
            </StackPanel>
        </Grid>

        <!-- Output file location -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Save Merged PDF to:" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOutputPath" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom" Height="30" Margin="8,0,0,0" Padding="12,0" Click="BtnBrowseOutput_Click"/>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Merge PDFs" Style="{DynamicResource AccentButtonStyle}" Padding="20,8" Click="BtnMerge_Click"/>
        </StackPanel>
    </Grid>
</Window>
