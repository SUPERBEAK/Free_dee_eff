<Application x:Class="Freedeeeff.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom styling tokens -->
            <SolidColorBrush x:Key="AppPrimaryColor" Color="#0078D7"/>
            <SolidColorBrush x:Key="AppHeaderBg" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="AppSidebarBg" Color="#FBFBFB"/>
            <SolidColorBrush x:Key="AppCanvasBg" Color="#525659"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
